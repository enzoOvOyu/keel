KEEL_IMAGE=keel:local
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
# Data services for development; generate unique credentials in the server-only .env.
POSTGRES_USER=keel
POSTGRES_DB=keel
POSTGRES_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Set by scripts/configure-development.py for loopback development only.
POSTGRES_APP_PASSWORD=
KEEL_ENV=development
KEEL_DATABASE_URL=
KEEL_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KEEL_INSECURE_DEV_COOKIE=false

# Explicit simulation execution profile; no real hardware runner is enabled.
KEEL_WORKER_ID=keel-sim-worker
KEEL_WORKER_CONCURRENCY=8
KEEL_WORKER_LEASE=5s

# Optional private media store. Provision a versioned bucket with keel-admin media-init.
# Use a dedicated service account in deployment, never browser-accessible credentials.
KEEL_MEDIA_ENDPOINT=
KEEL_MEDIA_ACCESS_KEY=
KEEL_MEDIA_SECRET_KEY=
KEEL_MEDIA_BUCKET=media

# Optional platform-signed artifact manifests; keep private keys outside Git.
# KEEL_MEDIA_SIGNING_DIRECTORY=/private/keel/media-signing
# KEEL_MEDIA_SIGNING_KEY_FILE=/run/keel/media-signing/manifest.key.pem

# Optional exact allowed origins for materializing registered HTTP(S) source URLs.
# No userinfo/query/fragment; HTTP and explicit loopback are development-only. Empty disables fetching.
KEEL_MEDIA_FETCH_ORIGINS=

# Optional SSH allowlist and keys live outside Git, mounted read-only.
# Empty file configuration disables SSH; never store private keys here.
KEEL_SSH_RUNNER_DIRECTORY=./infra/ssh-runner-disabled
KEEL_SSH_RUNNER_FILE=
