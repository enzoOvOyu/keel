{
  "name": "@keel/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "routes": "tsr generate",
    "dev": "npm run tokens && vite --host 127.0.0.1",
    "typecheck": "npm run api:generate && npm run tokens && npm run routes && npm run check:ui && npm run check:versions && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/generated/api.d.ts && openapi-typescript ../api/execution.openapi.yaml -o src/generated/execution.d.ts",
    "ui:add": "shadcn add",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "check:versions": "node --test scripts/check-version-inputs.test.mjs && node scripts/check-version-inputs.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-virtual": "3.14.22",
    "get-nonce": "1.0.1",
    "i18next": "26.4.4",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "@tailwindcss/vite": "4.3.3",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3"
  }
}
