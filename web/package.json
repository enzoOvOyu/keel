{
  "name": "@keel/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "routes": "tsr generate",
    "dev": "npm run tokens && vite --host 127.0.0.1",
    "typecheck": "npm run api:generate && npm run tokens && npm run routes && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/generated/api.d.ts && openapi-typescript ../api/execution.openapi.yaml -o src/generated/execution.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-virtual": "3.14.22",
    "i18next": "26.4.4",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
